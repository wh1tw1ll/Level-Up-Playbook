// api/auth/debug.js — temporary, remove after testing
export default function handler(req, res) {
  const raw = req.headers['cookie'] || '';
  const hasAuth = raw.includes('lu_auth');
  res.json({
    hasCookie: !!raw,
    hasLuAuth: hasAuth,
    cookieLength: raw.length,
    cookiePreview: raw.substring(0, 100),
    allHeaders: Object.keys(req.headers),
  });
}
