{
  "functions": {
    "api/chat.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 20
    }
  },
  "routes": [
    { "src": "/auth/login", "dest": "/api/auth/login.js" },
    { "src": "/auth/callback", "dest": "/api/auth/callback.js" },
    { "src": "/auth/me", "dest": "/api/auth/me.js" },
    { "src": "/auth/logout", "dest": "/api/auth/logout.js" },
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/api/sharepoint/search", "dest": "/api/sharepoint/search.js" },
    { "src": "/api/sharepoint/read", "dest": "/api/sharepoint/read.js" },
    { "src": "/api/outlook/email", "dest": "/api/outlook/email.js" },
    { "src": "/api/outlook/calendar", "dest": "/api/outlook/calendar.js" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/data/(.*)", "dest": "/data/$1" },
    { "src": "/templates/(.*)", "dest": "/templates/$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}