{
  "rewrites": [
    { "source": "/", "destination": "/api/dova-dashboard" },
    { "source": "/auth/login", "destination": "/api/oauth?provider=microsoft&action=login" },
    { "source": "/auth/callback", "destination": "/api/oauth?provider=microsoft&action=callback" },
    { "source": "/auth/me", "destination": "/api/oauth?provider=microsoft&action=me" },
    { "source": "/auth/logout", "destination": "/api/oauth?provider=microsoft&action=logout" },
    { "source": "/procore/login", "destination": "/api/oauth?provider=procore&action=login" },
    { "source": "/procore/callback", "destination": "/api/oauth?provider=procore&action=callback" },
    { "source": "/procore/data", "destination": "/api/oauth?provider=procore&action=data" },
    { "source": "/procore/discover", "destination": "/api/oauth?provider=procore&action=discover" },
    { "source": "/api/(.*)", "destination": "/api/index?path=$1" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}