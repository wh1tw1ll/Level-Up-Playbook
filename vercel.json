{
  "functions": {
    "api/chat.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 20
    }
  },
  "routes": [
      { "src": "/auth/login", "dest": "/api/auth2/login" },
      { "src": "/auth/callback", "dest": "/api/auth2/callback" },
      { "src": "/auth/me", "dest": "/api/auth2/me" },
      { "src": "/auth/logout", "dest": "/api/auth2/logout" },
      { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/api/sharepoint/search", "dest": "/api/sharepoint/search.js" },
    { "src": "/api/sharepoint/read", "dest": "/api/sharepoint/read.js" },
    { "src": "/api/outlook/email", "dest": "/api/outlook/email.js" },
    { "src": "/api/outlook/calendar", "dest": "/api/outlook/calendar.js" },
        { "src": "/procore/(.*)", "dest": "/api/procore/[...slug].js" },
        { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}